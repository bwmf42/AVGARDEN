# =============================================
# Stage 1: Build Go backend
# =============================================
FROM golang:1.22-bookworm AS go-builder

ENV GOPROXY=https://goproxy.cn,direct

RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends gcc libc6-dev &&     rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY backend/ ./backend/
RUN cd backend &&     go mod tidy &&     CGO_ENABLED=1 go build -o /build/av-garden-server

# =============================================
# Stage 2: Build Vue frontend
# =============================================
FROM node:lts-alpine AS vue-builder

# Bake the same key the Go server uses for /api/addvideo Bearer auth.
# Pass at build: docker compose build --build-arg VITE_API_KEY="$API_KEY"
ARG VITE_API_KEY=
ENV VITE_API_KEY=$VITE_API_KEY

WORKDIR /build
COPY frontend/ ./frontend/
RUN cd frontend &&     npm install &&     npm run build

# =============================================
# Stage 3: Final server image (Debian slim, 兼容 glibc)
# =============================================
FROM debian:bookworm-slim

RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends ca-certificates tzdata curl &&     rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=vue-builder /build/frontend/dist /app/frontend/dist
COPY --from=go-builder /build/av-garden-server /app/av-garden-server
COPY VERSION /app/VERSION
# Identity is refreshed on every deploy via docker cp (see deploy.sh step 5b).
# Stub keeps /api/version happy before the first post-deploy inject.
RUN printf '%s\n' \
    '{"version":"dev","git_sha":"unknown","git_dirty":false,"tree_hash":"","built_at":"","built_on":"image"}' \
    > /app/BUILD_INFO.json
RUN mkdir -p /db /cfg /data

EXPOSE 31471
ENTRYPOINT /app/av-garden-server
