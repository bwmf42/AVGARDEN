FROM golang:alpine AS m3u8-builder
ENV GOPROXY=https://goproxy.cn,direct
WORKDIR /build
RUN apk add --no-cache git && git clone https://github.com/Greyh4t/m3u8-Downloader-Go.git src && cd src && git checkout tags/v1.5.2 && go build -o /build/m3u8-Downloader-Go

FROM alpine:3.21
WORKDIR /app
RUN apk add --no-cache python3 py3-pip ffmpeg tzdata && rm -rf /var/cache/apk/*
COPY --from=m3u8-builder /build/m3u8-Downloader-Go /app/tools/m3u8-Downloader-Go
RUN chmod +x /app/tools/m3u8-Downloader-Go
RUN python3 -m venv /app/venv
COPY requirements.txt /app/
RUN /app/venv/bin/pip install --no-cache-dir -r requirements.txt
COPY src/ /app/src/
COPY cfg/ /app/cfg/
COPY metadata.py /app/
COPY worker.py /app/
COPY main_video.py /app/
COPY qb_task_guard.py /app/
COPY queue_api.py /app/
COPY launcher.py /app/
COPY process_control.py /app/
COPY queue_store.py /app/
COPY video_id.py /app/
COPY weekly_store.py /app/
COPY weekly_watched_store.py /app/
COPY weekly_updater.py /app/
COPY plwt_art_backfill.py /app/
COPY plwt_genre_normalize.py /app/
COPY plwt_actress_fix.py /app/
COPY plwt_titlezh_repair.py /app/
COPY plwt_translate_missing.py /app/
COPY heal_runner.py /app/
COPY weekly_backfill_details.py /app/
COPY replace_chinese.py /app/
COPY tools/maintenance/storage_cleanup.py /app/tools/maintenance/
COPY tools/maintenance/weekly_cache_maintenance.py /app/tools/maintenance/
COPY tools/maintenance/weekly_retention_maintenance.py /app/tools/maintenance/
RUN mkdir -p /data /db /cfg /logs
EXPOSE 31473
ENTRYPOINT /usr/bin/python3 -u /app/launcher.py
