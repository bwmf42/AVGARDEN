FROM golang:alpine AS m3u8-builder
WORKDIR /build
RUN apk add --no-cache git && git clone https://github.com/Greyh4t/m3u8-Downloader-Go.git src && cd src && git checkout tags/v1.5.2 && go build -o /build/m3u8-Downloader-Go

FROM alpine:latest
WORKDIR /app
RUN apk add --no-cache python3 py3-pip ffmpeg tzdata && rm -rf /var/cache/apk/*
COPY --from=m3u8-builder /build/m3u8-Downloader-Go /app/tools/m3u8-Downloader-Go
RUN chmod +x /app/tools/m3u8-Downloader-Go
RUN python3 -m venv /app/venv
COPY requirements.txt /app/
RUN /app/venv/bin/pip install --no-cache-dir -r requirements.txt
COPY src/ /app/src/
COPY cfg/ /app/cfg/
COPY metadata.py /app/
COPY worker.py /app/
COPY queue_api.py /app/
COPY launcher.py /app/
COPY weekly_updater.py /app/
COPY weekly_backfill_details.py /app/
COPY replace_chinese.py /app/
RUN mkdir -p /data /db /cfg /logs
ENTRYPOINT /usr/bin/python3 -u /app/launcher.py
