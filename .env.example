# A/GARDEN deployment settings
#
# Copy this file to .env, then edit values for your own machine/NAS.
# Do not commit or share the real .env file.

# Host paths. AV_GARDEN_DATA_DIR must be an absolute path on the Docker host.
AV_GARDEN_DATA_DIR=/absolute/path/to/your/video-library
AV_GARDEN_DB_DIR=./db
AV_GARDEN_CFG_DIR=./cfg
AV_GARDEN_LOG_DIR=./logs

# Web UI
AV_GARDEN_HTTP_PORT=31471
API_KEY=
TZ=Asia/Shanghai

# Proxy used by downloaders and weekly metadata jobs. Leave empty if unused.
PROXY=

# qBittorrent Web UI. If qBittorrent runs on the Docker host, try host.docker.internal.
QBITTORRENT_URL=http://host.docker.internal:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=change_me

# Optional notifications and translation.
FEISHU_WEBHOOK=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Weekly recommendation: 98堂 forum-37 list (default 3 pages).
# Metadata: MGS genres first; exact DMM only when MGS has no genres; exact
# javdatabase is the final metadata fallback. Artwork: javdatabase → MGS →
# exact DMM → the item's known forum attachments → existing item URLs.
# WEEKLY_LIST_SOURCE=javbus falls back to JavBus 今日新種.
WEEKLY_LIST_SOURCE=plwt
WEEKLY_FORUM_FID=37
WEEKLY_MAX_PAGES=3
WEEKLY_MAX_NEW=20
# Existing unwatched entries keep accumulating; this age only gates newly found items.
WEEKLY_MAX_AGE=30

# Genre Chinese map memory (persistent; not re-translated every scrape)
# GENRE_ZH_MEMORY=/db/genre_zh_memory.json

# Artwork sources (artwork.py)
# ARTWORK_SKIP_JAVDATABASE=1
# ARTWORK_SKIP_DMM=1
# ARTWORK_SKIP_MGS=1              # skip MGS metadata in enrich
# ARTWORK_SKIP_MGS_IMAGES=1       # skip MGS product images in artwork
# JAVDATABASE_DELAY=0.85          # polite gap between javdatabase HTML fetches
# DMM_DELAY=0.9                   # polite gap between DMM HTML/CDN/GraphQL
# DMM_MAX_SAMPLES=8               # max sample stills per cid
# DMM_CID_FALLBACK_LIMIT=1        # cid patterns when search misses
# DMM_GRAPHQL_CANDIDATE_LIMIT=3   # multi-id GraphQL batch size
# Art backfill (plwt_art_backfill.py): default only 未看 after tag filter
# BACKFILL_UNWATCHED_ONLY=1
# BACKFILL_FANART_LIMIT=8
# BACKFILL_SAVE_EVERY=15

# Chinese-subtitle forum (replace_chinese). Daily: 2 list pages of forum-103 after weekly.
# Same host as weekly (98堂/色花堂). One-time: CHINESE_FORUM_BACKFILL=1.
CHINESE_FORUM_BASE=https://plwt.kpqq4.com
CHINESE_FORUM_FID=103
CHINESE_FORUM_DAILY_PAGES=2
CHINESE_FORUM_BACKFILL=0
CHINESE_FORUM_MAX_PAGES=0
CHINESE_FORUM_PAGE_DELAY_MIN=12
CHINESE_FORUM_PAGE_DELAY_MAX=20
CHINESE_FORUM_THREAD_DELAY_MIN=25
CHINESE_FORUM_THREAD_DELAY_MAX=40

# Manual/search download-source resolution.
# One 98堂 search is shared by online detail and Worker; site searches stay 31s apart.
DOWNLOAD_SOURCE_CACHE_TTL_SECONDS=86400
PLWT_SEARCH_INTERVAL_SECONDS=31
# Keep a freshly registered item visible while Worker moves it from queue.txt to current.
QUEUE_REGISTRATION_GRACE_SECONDS=120
